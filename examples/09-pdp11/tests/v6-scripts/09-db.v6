# 09-db.v6 — db デバッガによる逆アセンブル確認
#
# 検証内容 (docs/09-PDP11/25-as-db-命令シーケンスデモ.md §3.2 に準拠):
#   loop.s をアセンブルし db a.out で逆アセンブルを試みる
#   0,6? → 先頭 6 ワード分を逆アセンブル
#   %   → db 終了してシェルへ戻る
#
# 期待動作 (docs/25 §3.2):
#   0:    mov   $1000,r0
#   4:    clr   r1
#   6:    add   r0,r1
#   10:   sob   r0,6
#   12:   sys   1
#
# 現状の制約:
#   V6 db は a.out を fork+exec して ptrace で制御するが、
#   このシミュレータでは ptrace が正常動作せず、全コマンドで
#   "Memory fault -- Core dumped" でクラッシュする。
#   T-bit は RTL 実装済み (pdp11.v psw[4], ベクタ 14 のトレーストラップ) だが、
#   ptrace syscall (sys 26) の fork/exec フローが正常完了しない。
#   このテストは db 起動 → コマンド送信 → クラッシュ → shell 復帰
#   の一連の動作を確認する（#が返ることを検証）。
#
# 注: db はプロンプトを一切出さない（起動しても無音で入力待ち）。

wait @
send rkunix\r
expect login:
send root\r
expect #

# ループ加算プログラムを作成してアセンブル (docs/25 §3.1)
send cat >loop.s\r
send start:\r
send  mov $1000,r0\r
send  clr r1\r
send loop:\r
send  add r0,r1\r
send  sob r0,loop\r
send  sys 1\r
send \004
expect #

timeout 100000000
send as loop.s\r
expect #

# db で逆アセンブル (docs/25 §3.2)
timeout 200000000
send db a.out\r
send 0,6?\r
send %\r
expect #
